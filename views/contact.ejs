<%- include('partials/header') %>

<!-- Chinchpokli Style Hero Header Banner (Bright Saffron Crimson Light Theme) -->
<section style="background: linear-gradient(135deg, #800020 0%, #E65100 100%); padding: 3.5rem 0; text-align: center; border-bottom: 4px solid var(--chintamani-gold);">
  <div class="container">
    <div style="width: 64px; height: 64px; margin: 0 auto 0.6rem; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));">
      <img src="/images/logo.png" alt="Mumbai Central Cha Raja Logo" style="width: 100%; height: 100%; object-fit: contain;">
    </div>
    <h1 style="font-family: 'Rozha One', 'Noto Sans Devanagari', serif; font-size: 3.2rem; color: #FFFFFF; font-weight: 800; margin: 0;" data-i18n="contact_header_title">
      संपर्क
    </h1>
    <p style="color: #FFF5E6; font-size: 0.95rem; margin-top: 0.5rem;" data-i18n="contact_header_sub">
      बेलासिस रोड बी.आय.टी. चाळ सार्वजनिक श्री गणेशोत्सव मंडळ कार्यकारिणी.
    </p>
  </div>
</section>

<!-- Chinchpokli Style Soft Cream Contact Container Box -->
<section style="padding: 4rem 0; background: var(--bg-surface);">
  <div class="container">
    <div class="cream-container-box">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem;">
        
        <!-- Left Column: Head Office & Travel Routes -->
        <div>
          <h2 style="font-size: 2rem; color: var(--chintamani-red); font-weight: 800; margin-bottom: 0.6rem;" data-i18n="office_address_label">
            मुख्य कार्यालय
          </h2>
          <p style="color: var(--text-muted); font-size: 1.05rem; margin-bottom: 2rem; line-height: 1.7;" data-i18n="footer_address">
            बेलासिस रोड, बी.आय.टी. चाळ, मुंबई सेंट्रल (पु.), मुंबई - ४००००८.
          </p>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1.5rem;">
            <!-- Nearest Railway Stations Box -->
            <div style="background: #FFFFFF; border-radius: var(--radius-md); padding: 1.4rem; border: 1px solid #E0C097; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
              <h3 style="font-size: 1.15rem; color: var(--chintamani-red); margin-bottom: 0.8rem; font-weight: 800; display: flex; align-items: center; gap: 0.4rem;">
                <ctrl42> Nearest Railway Stations:
              </h3>
              <ol style="padding-left: 1.2rem; color: var(--text-main); font-size: 0.92rem; line-height: 1.8;">
                <li>Mumbai Central (0.5 km)</li>
                <li>Byculla Station (1 km)</li>
                <li>Grant Road Station (1 km)</li>
              </ol>
            </div>

            <!-- Nearest Bus Stops Box -->
            <div style="background: #FFFFFF; border-radius: var(--radius-md); padding: 1.4rem; border: 1px solid #E0C097; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
              <h3 style="font-size: 1.15rem; color: var(--chintamani-red); margin-bottom: 0.8rem; font-weight: 800; display: flex; align-items: center; gap: 0.4rem;">
                🚌 Nearest Bus Stops:
              </h3>
              <ol style="padding-left: 1.2rem; color: var(--text-main); font-size: 0.92rem; line-height: 1.8;">
                <li>BIT Chawl Junction</li>
                <li>Mumbai Central East</li>
                <li>Nair Hospital Chowk</li>
              </ol>
            </div>
          </div>

          <!-- Direct Helpline Box -->
          <div style="margin-top: 2rem; background: #FFFFFF; border-radius: var(--radius-md); padding: 1.4rem; border: 2px solid var(--chintamani-gold);">
            <h4 style="font-size: 1rem; color: var(--chintamani-red); margin-bottom: 0.4rem; font-weight: 800;" data-i18n="emergency_desk_label">
              📞 २४/७ मण्डल आपत्कालीन हेल्पलाईन
            </h4>
            <p style="font-size: 1.1rem; font-weight: 800; color: #1E293B; margin: 0;">
              +91 98765 43210 / +91 91234 56789
            </p>
            <p style="font-size: 0.88rem; color: var(--text-muted); margin-top: 0.2rem;" data-i18n="email_label">
              Email: contact@mumbaicentralcharaja.org
            </p>
          </div>
        </div>

        <!-- Right Column: Interactive Contact Form -->
        <div>
          <h2 style="font-size: 2rem; color: var(--chintamani-red); font-weight: 800; margin-bottom: 1.5rem;" data-i18n="nav_contact">
            संपर्क फॉर्म
          </h2>

          <form id="contactForm" onsubmit="event.preventDefault(); showToast('✅ Message Sent Successfully!', 'success'); this.reset();">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
              <div class="form-group">
                <label class="form-label" style="font-weight: 700;" data-i18n="lbl_contact_name">तुमचे नाव *</label>
                <input type="text" class="form-control" placeholder="संपूर्ण नाव टाका" data-i18n="ph_contact_name" required style="background: #FFFFFF; border-color: #E0C097;">
              </div>
              <div class="form-group">
                <label class="form-label" style="font-weight: 700;" data-i18n="lbl_contact_email">तुमचा ईमेल *</label>
                <input type="email" class="form-control" placeholder="ईमेल पत्ता टाका" data-i18n="ph_contact_email" required style="background: #FFFFFF; border-color: #E0C097;">
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
              <div class="form-group">
                <label class="form-label" style="font-weight: 700;" data-i18n="lbl_mobile">मोबाईल नंबर *</label>
                <input type="tel" class="form-control" placeholder="१० अंकी मोबाईल नंबर टाका" data-i18n="ph_mobile" required style="background: #FFFFFF; border-color: #E0C097;">
              </div>
              <div class="form-group">
                <label class="form-label" style="font-weight: 700;">विषय (Subject)</label>
                <input type="text" class="form-control" placeholder="Subject" style="background: #FFFFFF; border-color: #E0C097;">
              </div>
            </div>

            <div class="form-group" style="margin-bottom: 1.5rem;">
              <label class="form-label" style="font-weight: 700;" data-i18n="lbl_contact_msg">तुमचा संदेश / प्रश्न *</label>
              <textarea class="form-control" rows="5" placeholder="येथे संदेश लिहा..." data-i18n="ph_contact_msg" required style="background: #FFFFFF; border-color: #E0C097;"></textarea>
            </div>

            <button type="submit" class="btn btn-chintamani-primary" style="width: 100%; padding: 1.1rem; font-size: 1.15rem;">
              <span data-i18n="btn_send_msg">मंडळाला संदेश पाठवा</span>
            </button>
          </form>
        </div>

      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
