<%- include('partials/header') %>

<section style="background: linear-gradient(135deg, var(--temple-maroon) 0%, var(--maroon-dark) 100%); color: var(--bg-ivory); padding: 4.5rem 0; border-bottom: 3px solid var(--royal-gold); text-align: center;">
  <div class="container">
    <span class="section-badge" style="background: rgba(212, 175, 55, 0.2); color: var(--gold-soft); border-color: var(--royal-gold);">
      ८०जी कर सवलत प्राप्त
    </span>
    <h1 style="font-size: 3rem; color: var(--gold-soft); margin-top: 0.5rem;" data-i18n="donate_title">ऑनलाइन देणगी पोर्टल</h1>
    <p style="font-size: 1.15rem; color: #E5E7EB; max-width: 750px; margin: 1rem auto 0; line-height: 1.8;" data-i18n="donate_sub">
      मुंबई सेंट्रलच्या राजाच्या सामाजिक कार्याला आणि मण्डप व्यवस्थेला आपले पवित्र सहकार्य द्या.
    </p>
  </div>
</section>

<section style="background: var(--bg-cream); padding: 5rem 0;">
  <div class="container" style="max-width: 850px;">
    
    <div class="card-temple" style="padding: 3rem;">
      <h2 style="font-size: 1.8rem; color: var(--temple-maroon); margin-bottom: 1.5rem; text-align: center;">
        देणगी फॉर्म
      </h2>

      <form id="donationForm">
        <!-- Preset Amount Pills -->
        <div style="margin-bottom: 2rem;">
          <label style="display: block; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.8rem; color: var(--text-main); text-align: center;">
            देणगी रक्कम निवडा (₹) *
          </label>
          <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;" id="presetBtns">
            <button type="button" class="btn btn-outline preset-btn" data-val="501">₹ ५०१/-</button>
            <button type="button" class="btn btn-outline preset-btn active" data-val="1008" style="background: var(--temple-maroon); color: var(--gold-soft); border-color: var(--royal-gold);">₹ १००८/-</button>
            <button type="button" class="btn btn-outline preset-btn" data-val="2100">₹ २१००/-</button>
            <button type="button" class="btn btn-outline preset-btn" data-val="5001">₹ ५००१/-</button>
          </div>
        </div>

        <!-- Custom Amount -->
        <div style="margin-bottom: 1.5rem;">
          <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: var(--text-main);">
            किंवा तुमची रक्कम टाका (₹) *
          </label>
          <input type="number" id="donationAmount" value="1008" min="11" required style="width: 100%; padding: 0.85rem 1.2rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 1.1rem; font-weight: 700; color: var(--temple-maroon);">
        </div>

        <!-- Donor Name -->
        <div style="margin-bottom: 1.5rem;">
          <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: var(--text-main);">
            देणगीदाराचे संपूर्ण नाव *
          </label>
          <input type="text" id="donorName" required placeholder="संपूर्ण नाव टाका" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem;">
        </div>

        <!-- Contact Phone -->
        <div style="grid-template-columns: 1fr 1fr; display: grid; gap: 1rem; margin-bottom: 1.5rem;">
          <div>
            <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: var(--text-main);">
              मोबाईल नंबर *
            </label>
            <input type="tel" id="donorPhone" required placeholder="१० अंकी मोबाईल नंबर" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem;">
          </div>

          <div>
            <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: var(--text-main);">
              ईमेल आयडी (पर्यायी)
            </label>
            <input type="email" id="donorEmail" placeholder="पावतीसाठी ईमेल" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem;">
          </div>
        </div>

        <!-- PAN Card (Optional for 80G) -->
        <div style="margin-bottom: 2rem;">
          <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: var(--text-main);">
            पॅन कार्ड नंबर (८०जी कर सवलत पावतीसाठी)
          </label>
          <input type="text" id="donorPan" placeholder="उदा. ABCDE1234F" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem; text-transform: uppercase;">
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 1rem; font-size: 1.1rem; font-weight: 800;" id="btnDonateSubmit">
          सुरक्षित देणगी द्या व PDF पावती मिळवा <i class="bi bi-shield-check"></i>
        </button>
      </form>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const presetBtns = document.querySelectorAll('.preset-btn');
    const amountInput = document.getElementById('donationAmount');

    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        presetBtns.forEach(b => {
          b.style.background = 'transparent';
          b.style.color = 'var(--temple-maroon)';
        });
        btn.style.background = 'var(--temple-maroon)';
        btn.style.color = 'var(--gold-soft)';
        btn.style.borderColor = 'var(--royal-gold)';
        amountInput.value = btn.getAttribute('data-val');
      });
    });

    document.getElementById('donationForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btnDonateSubmit');
      btn.disabled = true;
      btn.innerText = 'देणगी प्रक्रिया सुरू आहे...';

      const payload = {
        amount: parseFloat(amountInput.value),
        donor_name: document.getElementById('donorName').value,
        phone: document.getElementById('donorPhone').value,
        email: document.getElementById('donorEmail').value,
        pan_number: document.getElementById('donorPan').value,
        receipt_no: `MCC-REC-2026-${Math.floor(100 + Math.random() * 900)}`,
        payment_id: `pay_sim_${Date.now()}`,
        order_id: `order_sim_${Date.now()}`,
        signature: `sig_sim_${Date.now()}`
      };

      try {
        const res = await fetch('/donate/confirm', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          alert('देणगी यशस्वी झाली! तुमची ८०जी पावती डाऊनलोड होत आहे.');
          window.location.href = `/download-receipt/${data.receipt_no}`;
        } else {
          alert(data.message || 'Error recording donation');
        }
      } catch(err) {
        alert('Error submitting donation.');
      } finally {
        btn.disabled = false;
        btn.innerText = 'सुरक्षित देणगी द्या व PDF पावती मिळवा';
      }
    });
  });
</script>

<%- include('partials/footer') %>
