<%- include('partials/header') %>

<section style="background: linear-gradient(135deg, var(--temple-maroon) 0%, var(--maroon-dark) 100%); color: var(--bg-ivory); padding: 4.5rem 0; border-bottom: 3px solid var(--royal-gold); text-align: center;">
  <div class="container">
    <span class="section-badge" style="background: rgba(212, 175, 55, 0.2); color: var(--gold-soft); border-color: var(--royal-gold);">
      ऐतिहासिक रूप दर्शन
    </span>
    <h1 style="font-size: 3rem; color: var(--gold-soft); margin-top: 0.5rem;" data-i18n="glimpses_title">Glimpses over the Year</h1>
    <p style="font-size: 1.15rem; color: #E5E7EB; max-width: 750px; margin: 1rem auto 0; line-height: 1.8;" data-i18n="glimpses_sub">
      मुंबई सेंट्रलच्या राजाचे विविध वर्षांतील विलोभनीय व मनमोहक रूप दर्शन.
    </p>
  </div>
</section>

<section style="background: var(--bg-cream); padding: 5rem 0;">
  <div class="container">
    <div class="grid-3">
      <% glimpsesData.forEach(item => { %>
        <div class="card-temple" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
          <div style="position: relative; height: 350px; overflow: hidden; background: #0A0A0A;">
            <img src="<%= item.image %>" alt="<%= item.title %>" style="width: 100%; height: 100%; object-fit: cover;">
            <div style="position: absolute; top: 14px; right: 14px; background: var(--temple-maroon); color: var(--gold-soft); font-weight: 800; font-size: 0.9rem; padding: 6px 16px; border-radius: var(--radius-full); border: 1.5px solid var(--royal-gold); box-shadow: var(--shadow-sm);">
              वर्ष <%= item.year %>
            </div>
          </div>
          <div style="padding: 1.8rem; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <h3 style="font-size: 1.35rem; color: var(--temple-maroon); margin-bottom: 0.6rem;"><%= item.title %></h3>
              <p style="font-size: 0.94rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 1.2rem;"><%= item.desc %></p>
            </div>
            
            <div style="border-top: 1px dashed var(--border-gold); padding-top: 1rem;">
              <div style="font-size: 0.85rem; color: var(--primary-saffron); font-weight: 700; margin-bottom: 0.3rem;">
                मूर्तीची उंची: <%= item.height %> | संकल्पना: <%= item.theme %>
              </div>
              <div style="font-size: 0.85rem; color: var(--text-main); font-weight: 700;">
                मूर्तिकार: <%= item.artist %>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
