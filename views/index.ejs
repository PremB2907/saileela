<%- include('partials/header') %>

<!-- 1. HERO SECTION (Cinematic Hero Experience) -->
<section class="hero-section">
  <!-- Subtle Floating Diyas / Particles background -->
  <div class="floating-diyas" id="heroParticles"></div>
  
  <div class="hero-content">
    <div class="section-badge" style="background: rgba(212, 175, 55, 0.15); color: var(--gold-soft); border-color: var(--royal-gold);">
      स्थापना १९८८ | बेलासिस रोड बी.आय.टी. चाळ
    </div>

    <h1 style="font-size: 3.5rem; font-family: var(--font-mr-head); color: var(--gold-soft); margin-bottom: 0.5rem; line-height: 1.2;" data-i18n="hero_title">
      मुंबई सेंट्रलचा राजा
    </h1>
    
    <p style="font-size: 1.5rem; font-family: var(--font-en-head); color: #FFFFFF; font-weight: 600; letter-spacing: 1px; margin-bottom: 1.2rem;">
      Faith Beyond Boundaries
    </p>

    <p class="hero-subtitle" data-i18n="hero_subtitle">
      बेलासिस रोड बी.आय.टी. चाळ सार्वजनिक श्री गणेशोत्सव मंडळ. अथांग श्रद्धा, भव्य परंपरा आणि संस्कृतीचा अद्वितीय वारसा.
    </p>

    <div class="hero-actions">
      <button class="btn btn-primary" style="font-size: 1.05rem; padding: 0.85rem 2.2rem;" id="btnHeroLiveDarshan">
        <i class="fa-solid fa-play" style="color: var(--royal-gold);"></i> <span data-i18n="btn_live_darshan">लाइव्ह दर्शन</span>
      </button>

      <a href="/about" class="btn btn-outline" style="font-size: 1.05rem; padding: 0.85rem 2.2rem; color: var(--bg-ivory); border-color: var(--royal-gold);">
        <i class="fa-solid fa-landmark" style="color: var(--royal-gold);"></i> <span data-i18n="btn_know_history">इतिहास व परंपरा</span>
      </a>
    </div>
  </div>
</section>

<!-- 2. WELCOME & FOUNDER'S BLESSING SECTION -->
<section style="background: var(--bg-cream); padding: 5rem 0;">
  <div class="container">
    <div class="grid-2" style="align-items: center;">
      <div>
        <div class="section-badge">अध्यक्ष व कार्यकारिणी संदेश</div>
        <h2 class="section-title">हार्दिक स्वागत व मनःपूर्वक आशीर्वाद</h2>
        <p style="color: var(--text-muted); font-size: 1.05rem; line-height: 1.8; margin-bottom: 1.5rem;">
          मुंबई सेंट्रलचा राजा बेलासिस रोड बी.आय.टी. चाळ सार्वजनिक श्री गणेशोत्सव मंडळाच्या अधिकृत डिजिटल मंदिरात आपले स्वागत आहे. १९८८ पासून आमचे मंडळ सामाजिक ऐक्य, भक्ती आणि संस्कृतीचे संवर्धन करत आहे.
        </p>
        <p style="color: var(--text-muted); font-size: 1.05rem; line-height: 1.8; margin-bottom: 2rem;">
          दरवर्षी लाखो भाविक राजाच्या दर्शनासाठी येतात. यंदाच्या गणेशोत्सवात digital temple द्वारे जगभरातील भाविकांना राजाचे साक्षात दर्शन आणि सेवा उपलब्ध करून देत आहोत.
        </p>

        <div style="display: flex; gap: 1.5rem; border-left: 3px solid var(--royal-gold); padding-left: 1.2rem;">
          <div>
            <h4 style="margin: 0; color: var(--temple-maroon);">श्री. प्रकाश सावंत</h4>
            <p style="margin: 0; font-size: 0.88rem; color: var(--primary-saffron); font-weight: 700;">अध्यक्ष, मुंबई सेंट्रलचा राजा मंडळ</p>
          </div>
        </div>
      </div>

      <div style="position: relative;">
        <div style="border-radius: var(--radius-lg); overflow: hidden; border: 3px solid var(--royal-gold); box-shadow: var(--shadow-lg);">
          <img src="/images/mandap.png" alt="Mumbai Central Cha Raja Mandap" style="width: 100%; height: 420px; object-fit: cover; display: block;">
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 3. GLIMPSES OVER THE YEAR (Replacing 5 sacred forms) -->
<section style="background: var(--bg-ivory); border-top: 1px solid var(--border-gold); border-bottom: 1px solid var(--border-gold);">
  <div class="container">
    <div class="section-header">
      <span class="section-badge" data-i18n="glimpses_tag">ऐतिहासिक वारसा</span>
      <h2 class="section-title" data-i18n="glimpses_title">Glimpses over the Year</h2>
      <p class="section-subtitle" data-i18n="glimpses_sub">
        मुंबई सेंट्रलच्या राजाचे विविध वर्षांतील विलोभनीय व मनमोहक रूप दर्शन.
      </p>
      <div class="gold-divider"></div>
    </div>

    <div class="grid-3">
      <% glimpsesData.forEach(item => { %>
        <div class="card-temple" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
          <div style="position: relative; height: 320px; overflow: hidden; background: #0A0A0A;">
            <img src="<%= item.image %>" alt="<%= item.title %>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;">
            <div style="position: absolute; top: 12px; right: 12px; background: var(--temple-maroon); color: var(--gold-soft); font-weight: 800; font-size: 0.85rem; padding: 4px 12px; border-radius: var(--radius-full); border: 1px solid var(--royal-gold);">
              <%= item.year %>
            </div>
          </div>
          <div style="padding: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;"><%= item.title %></h3>
              <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 1rem;"><%= item.desc %></p>
            </div>
            <div style="border-top: 1px dashed var(--border-gold); padding-top: 0.8rem; font-size: 0.82rem; color: var(--primary-saffron); font-weight: 700;">
              मूर्तिकार: <%= item.artist %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <div style="text-align: center; margin-top: 3rem;">
      <a href="/glimpses" class="btn btn-outline">
        सर्व वर्षांची चित्रे पाहा <i class="bi bi-arrow-right"></i>
      </a>
    </div>
  </div>
</section>

<!-- 4. PHOTO BOOTH FOR GANPATI MANDAL (Separate Showcase) -->
<section style="background: var(--bg-cream);">
  <div class="container">
    <div class="section-header">
      <span class="section-badge" data-i18n="photobooth_tag">डिजिटल आठवण</span>
      <h2 class="section-title" data-i18n="photobooth_title">Photo Booth for Ganpati Mandal</h2>
      <p class="section-subtitle" data-i18n="photobooth_sub">
        मुंबई सेंट्रलच्या राजासोबत आपली आठवण जपून ठेवा. डिजिटल फोटो फ्रेम निवडा व फोटो तयार करा.
      </p>
      <div class="gold-divider"></div>
    </div>

    <div class="grid-2" style="align-items: center;">
      <div>
        <h3 style="font-size: 1.8rem; margin-bottom: 1rem; color: var(--temple-maroon);">
          डिजिटल राजेशाही फोटो फ्रेम
        </h3>
        <p style="color: var(--text-muted); font-size: 1.02rem; line-height: 1.8; margin-bottom: 1.5rem;">
          भाविक आपल्या मोबाईलवरून किंवा कॉम्प्युटरवरून फोटो अपलोड करून राजाच्या सुवर्ण चौकट फ्रेममध्ये फोटो डाउनलोड करू शकतात.
        </p>

        <ul style="list-style: none; margin-bottom: 2rem;">
          <li style="margin-bottom: 0.8rem; font-size: 0.98rem; font-weight: 600;">
            <i class="fa-solid fa-check" style="color: var(--primary-saffron); margin-right: 8px;"></i> राजेशाही सुवर्ण चौकट व पेशवाई नक्षीकाम
          </li>
          <li style="margin-bottom: 0.8rem; font-size: 0.98rem; font-weight: 600;">
            <i class="fa-solid fa-check" style="color: var(--primary-saffron); margin-right: 8px;"></i> हाय-रिझोल्युशन HD इमेज डाऊनलोड
          </li>
          <li style="margin-bottom: 0.8rem; font-size: 0.98rem; font-weight: 600;">
            <i class="fa-solid fa-check" style="color: var(--primary-saffron); margin-right: 8px;"></i> इन्स्टाग्राम व व्हॉट्सॲप शेअरिंग
          </li>
        </ul>

        <a href="/photo-booth" class="btn btn-primary">
          फोटो बूथ सुरू करा <i class="bi bi-camera"></i>
        </a>
      </div>

      <div style="text-align: center;">
        <div style="background: #FFFFFF; border-radius: var(--radius-lg); border: 2px solid var(--royal-gold); padding: 1.5rem; box-shadow: var(--shadow-md);">
          <img src="/images/raja_real_1.png" alt="Photo Booth Sample" style="width: 100%; height: 350px; object-fit: cover; border-radius: var(--radius-md); border: 4px solid var(--temple-maroon);">
          <p style="font-size: 0.88rem; color: var(--primary-saffron); font-weight: 700; margin-top: 1rem;">
            मुंबई सेंट्रलचा राजा - फोटो बूथ फ्रेम preview
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 5. SOCIAL WORK INITIATIVES -->
<section style="background: var(--bg-ivory); border-top: 1px solid var(--border-gold);">
  <div class="container">
    <div class="section-header">
      <span class="section-badge" data-i18n="socialwork_tag">समाजोपयोगी उपक्रम</span>
      <h2 class="section-title" data-i18n="socialwork_title">सामाजिक कार्य व उपक्रम</h2>
      <p class="section-subtitle" data-i18n="socialwork_sub">
        अन्नदान महाप्रसाद, रक्तदान शिबीर, मोफत आरोग्य तपासणी आणि शैक्षणिक मदतीतून समाजसेवा.
      </p>
      <div class="gold-divider"></div>
    </div>

    <div class="grid-2">
      <% socialWorkData.forEach(work => { %>
        <div class="card-temple" style="display: flex; gap: 1.5rem; align-items: center;">
          <img src="<%= work.image %>" alt="<%= work.title %>" style="width: 140px; height: 140px; object-fit: cover; border-radius: var(--radius-md); border: 2px solid var(--royal-gold); flex-shrink: 0;">
          <div>
            <span style="font-size: 0.78rem; font-weight: 800; color: var(--primary-saffron); text-transform: uppercase;"><%= work.category %></span>
            <h3 style="font-size: 1.2rem; margin: 0.3rem 0 0.5rem;"><%= work.title %></h3>
            <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6;"><%= work.desc %></p>
          </div>
        </div>
      <% }); %>
    </div>

    <div style="text-align: center; margin-top: 2.5rem;">
      <a href="/social-work" class="btn btn-outline">
        संपूर्ण सामाजिक कार्य पाहा <i class="bi bi-arrow-right"></i>
      </a>
    </div>
  </div>
</section>

<!-- 6. GANESHOTSAV EVENT SCHEDULE HIGHLIGHTS -->
<section style="background: var(--bg-cream);">
  <div class="container">
    <div class="section-header">
      <span class="section-badge" data-i18n="schedule_tag">उत्सव कार्यसूची</span>
      <h2 class="section-title" data-i18n="schedule_title">आगामी गणेशोत्सव वेळापत्रक</h2>
      <p class="section-subtitle" data-i18n="schedule_sub">
        दैनिक पूजा, महाआरती, भक्ती संध्या आणि विसर्जन मिरवणूक कार्यसूची.
      </p>
      <div class="gold-divider"></div>
    </div>

    <div class="grid-2">
      <% scheduleData.forEach(evt => { %>
        <div class="card-temple">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem;">
            <span style="background: var(--temple-maroon); color: var(--gold-soft); font-weight: 800; font-size: 0.8rem; padding: 4px 12px; border-radius: var(--radius-full);">
              <%= evt.date %>
            </span>
            <span style="font-size: 0.85rem; font-weight: 700; color: var(--primary-saffron);">
              दिवस <%= evt.day %>
            </span>
          </div>

          <h3 style="font-size: 1.3rem; margin-bottom: 0.6rem; color: var(--temple-maroon);"><%= evt.title %></h3>
          <p style="font-size: 0.92rem; color: var(--text-muted); margin-bottom: 1rem;">
            <i class="fa-solid fa-location-dot" style="color: var(--primary-saffron); margin-right: 6px;"></i> <%= evt.halt_location %>
          </p>

          <div style="border-top: 1px solid var(--border-subtle); padding-top: 0.8rem; display: flex; flex-wrap: wrap; gap: 0.5rem;">
            <% evt.facilities.forEach(fac => { %>
              <span style="font-size: 0.78rem; background: var(--saffron-light); color: var(--saffron-dark); font-weight: 700; padding: 2px 8px; border-radius: 4px;">
                <%= fac %>
              </span>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </div>

    <div style="text-align: center; margin-top: 2.5rem;">
      <a href="/schedule" class="btn btn-primary">
        संपूर्ण १० दिवसांचे वेळापत्रक पाहा <i class="bi bi-calendar-event"></i>
      </a>
    </div>
  </div>
</section>

<!-- 7. SEVA CALLOUT BANNER (DONATION ONLY - NO CATEGORY SELECT) -->
<section style="background: linear-gradient(135deg, var(--temple-maroon) 0%, var(--maroon-dark) 100%); color: var(--bg-ivory); border-top: 3px solid var(--royal-gold); border-bottom: 3px solid var(--royal-gold); text-align: center;">
  <div class="container" style="max-width: 850px;">
    <span class="section-badge" style="background: rgba(212, 175, 55, 0.2); color: var(--gold-soft); border-color: var(--royal-gold);" data-i18n="donate_tag">
      सेवा योगदान
    </span>
    <h2 style="font-size: 2.4rem; color: var(--gold-soft); margin-top: 0.5rem; margin-bottom: 1.2rem;" data-i18n="donate_title">
      मुंबई सेंट्रलचा राजा सेवेला पाठिंबा द्या
    </h2>
    <p style="font-size: 1.1rem; color: #E5E7EB; line-height: 1.8; margin-bottom: 2.2rem;" data-i18n="donate_sub">
      तुमची देणगी सामाजिक कार्य, अन्नदान महाप्रसाद व मंडप व्यवस्थापनासाठी वापरली जाते. सर्व देणग्यांना कलम 80G अंतर्गत ५०% कर सवलत मिळतो.
    </p>

    <a href="/donate" class="btn btn-primary" style="background: var(--royal-gold); color: var(--maroon-dark); border: none; font-size: 1.1rem; padding: 0.9rem 2.5rem; font-weight: 800;">
      ऑनलाइन देणगी द्या (८०जी पावतीसह) <i class="bi bi-heart-fill"></i>
    </a>
  </div>
</section>

<%- include('partials/footer') %>
