<%- include('partials/header') %>

<!-- Mumbai Central Cha Raja Regal Hero Section -->
<section class="hero-chintamani" style="background: linear-gradient(135deg, #160B28 0%, #3A0318 50%, #4A0404 100%); padding: 5rem 0; border-bottom: 4px solid var(--chintamani-gold);">
  <div class="container">
    <div class="hero-grid">
      <div>
        <div class="hero-badge-festive" style="background: rgba(255, 215, 0, 0.15); border: 1px solid #FFD700; color: #FFD700;">
          <i class="fa-solid fa-crown"></i> <span data-i18n="hero_badge">अधिकृत गणेशोत्सव महोत्सव २०२६</span>
        </div>
        <h1 class="hero-title-chintamani" style="color: #FFFFFF; font-size: 2.8rem; margin: 1rem 0;">
          मुंबई सेंट्रलचा राजा <span style="color: #FFD700; text-shadow: 0 0 15px rgba(255,215,0,0.4);">ऑफिशियल</span>
        </h1>
        <p class="hero-subtitle-chintamani" data-i18n="hero_subtitle" style="color: #E2E8F0; font-size: 1.15rem; line-height: 1.8;">
          बेलासिस रोड बी.आय.टी. चाळ सार्वजनिक श्री गणेशोत्सव मंडळ. तुमचा अधिकृत व्हीआयपी दर्शन पास मिळवा, थेट आरती स्ट्रीम पाहा आणि मोदक व महाप्रसाद सेवेत योगदान द्या.
        </p>
        
        <div class="hero-actions" style="margin-top: 2rem;">
          <a href="/register-pass" class="btn btn-chintamani-primary" style="background: linear-gradient(135deg, #800020 0%, #4A0404 100%); border-color: #FFD700;">
            <i class="bi bi-person-badge-fill"></i> <span data-i18n="btn_get_pass">अधिकृत पास मिळवा</span>
          </a>
          <a href="/schedule" class="btn btn-chintamani-secondary" style="color: #FFFFFF !important; border-color: rgba(255,255,255,0.4);">
            <i class="bi bi-calendar-event-fill"></i> <span data-i18n="btn_view_route">आरती व कार्यक्रम पाहा</span>
          </a>
          <a href="/donate" class="btn btn-chintamani-primary" style="background: linear-gradient(135deg, #FF6F00 0%, #FFD700 100%); color: #000000; font-weight: 800;">
            <i class="bi bi-heart-fill"></i> <span data-i18n="btn_support_annadan">मोदक व महाप्रसाद सेवेत सहभाग घ्या</span>
          </a>
        </div>
      </div>

      <!-- Live Mandap Tracker Card -->
      <div class="hero-tracker-card" style="background: rgba(22, 11, 40, 0.85); border: 2px solid #FFD700; border-radius: var(--radius-lg); backdrop-filter: blur(10px); padding: 2rem;">
        <div class="hero-tracker-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
          <div>
            <h3 style="color: #FFD700; font-size: 1.3rem;" data-i18n="tracker_title">लाइव्ह मंडप ट्रॅकर</h3>
            <p style="font-size: 0.85rem; color: #CBD5E1;" data-i18n="tracker_subtitle">आरती व गर्दी थेट अपडेट</p>
          </div>
          <div class="live-pulse-tag" style="background: #DC2626; color: #FFFFFF; font-weight: 800; padding: 0.3rem 0.8rem; border-radius: var(--radius-full);">
            <span class="dot-pulse-red"></span> <span data-i18n="live_now">लाइव्ह सुरू</span>
          </div>
        </div>

        <div class="tracker-grid">
          <div class="tracker-stat">
            <div class="stat-label" data-i18n="current_location">मंडप स्थान</div>
            <div class="stat-value" id="statCurrentLocation" style="color: #FFFFFF; font-size: 0.95rem; font-weight: 700;">
              <%= yatraStatus.current_location %>
            </div>
          </div>
          <div class="tracker-stat">
            <div class="stat-label" data-i18n="next_halt">पुढील आरती / कार्यक्रम</div>
            <div class="stat-value" style="color: #FFD700; font-size: 0.95rem; font-weight: 700;">
              <%= yatraStatus.next_location %>
            </div>
          </div>
          <div class="tracker-stat">
            <div class="stat-label" data-i18n="distance_covered">महोत्सव प्रगती</div>
            <div class="stat-value" id="statDistanceCovered" style="color: #FFFFFF;">
              Day <%= yatraStatus.current_day %> of <%= yatraStatus.total_days %>
            </div>
          </div>
          <div class="tracker-stat">
            <div class="stat-label" data-i18n="meals_served">आजचे महाप्रसाद</div>
            <div class="stat-value" id="statMealsServed" style="color: #10B981; font-weight: 800;">
              <%= yatraStatus.meals_served_today.toLocaleString('en-IN') %>
            </div>
          </div>
        </div>

        <div style="margin-top: 1.2rem;">
          <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: #CBD5E1; margin-bottom: 0.4rem;">
            <span><span data-i18n="route_progress">१० दिवसांची प्रगती</span> (<span data-i18n="day_label">दिवस</span> <%= yatraStatus.current_day %> of <%= yatraStatus.total_days %>)</span>
            <strong style="color: #FFD700;"><%= Math.round((yatraStatus.current_day / yatraStatus.total_days) * 100) %>%</strong>
          </div>
          <div style="background: rgba(255,255,255,0.1); height: 10px; border-radius: 5px; overflow: hidden; border: 1px solid rgba(255,215,0,0.4);">
            <div style="width: <%= Math.round((yatraStatus.current_day / yatraStatus.total_days) * 100) %>%; height: 100%; background: linear-gradient(90deg, #FF6F00 0%, #FFD700 100%);"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Devotional Counter Metrics Bar -->
