<%- include('partials/header') %>

<!-- Mumbai Central Cha Raja Regal Hero Section -->
<section class="hero-chintamani" style="background: linear-gradient(135deg, #160B28 0%, #3A0318 50%, #4A0404 100%); padding: 5rem 0; border-bottom: 4px solid var(--chintamani-gold);">
  <div class="container">
    <div class="hero-grid">
      <div>
        <div class="hero-badge-festive" style="background: rgba(255, 215, 0, 0.15); border: 1px solid #FFD700; color: #FFD700;">
          <i class="fa-solid fa-crown"></i> <span data-i18n="hero_badge">अधिकृत गणेशोत्सव महोत्सव २०२६</span>
        </div>
        <h1 class="hero-title-chintamani" style="color: #FFFFFF; font-size: 2.8rem; margin: 1rem 0;">
          मुंबई सेंट्रलचा राजा <span style="color: #FFD700; text-shadow: 0 0 15px rgba(255,215,0,0.4);">ऑफिशियल</span>
        </h1>
        <p class="hero-subtitle-chintamani" data-i18n="hero_subtitle" style="color: #E2E8F0; font-size: 1.15rem; line-height: 1.8;">
          बेलासिस रोड बी.आय.टी. चाळ सार्वजनिक श्री गणेशोत्सव मंडळ. तुमचा अधिकृत व्हीआयपी दर्शन पास मिळवा, थेट आरती स्ट्रीम पाहा आणि मोदक व महाप्रसाद सेवेत योगदान द्या.
        </p>
        
        <div class="hero-actions" style="margin-top: 2rem;">
          <a href="/register-pass" class="btn btn-chintamani-primary" style="background: linear-gradient(135deg, #800020 0%, #4A0404 100%); border-color: #FFD700;">
            <i class="bi bi-person-badge-fill"></i> <span data-i18n="btn_get_pass">अधिकृत पास मिळवा</span>
          </a>
          <a href="/schedule" class="btn btn-chintamani-secondary" style="color: #FFFFFF !important; border-color: rgba(255,255,255,0.4);">
            <i class="bi bi-calendar-event-fill"></i> <span data-i18n="btn_view_route">आरती व कार्यक्रम पाहा</span>
          </a>
          <a href="/donate" class="btn btn-chintamani-primary" style="background: linear-gradient(135deg, #FF6F00 0%, #FFD700 100%); color: #000000; font-weight: 800;">
            <i class="bi bi-heart-fill"></i> <span data-i18n="btn_support_annadan">मोदक व महाप्रसाद सेवेत सहभाग घ्या</span>
          </a>
        </div>
      </div>

      <!-- Live Mandap Tracker Card -->
      <div class="hero-tracker-card" style="background: rgba(22, 11, 40, 0.85); border: 2px solid #FFD700; border-radius: var(--radius-lg); backdrop-filter: blur(10px); padding: 2rem;">
        <div class="hero-tracker-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
          <div>
            <h3 style="color: #FFD700; font-size: 1.3rem;" data-i18n="tracker_title">लाइव्ह मंडप ट्रॅकर</h3>
            <p style="font-size: 0.85rem; color: #CBD5E1;" data-i18n="tracker_subtitle">आरती व गर्दी थेट अपडेट</p>
          </div>
          <div class="live-pulse-tag" style="background: #DC2626; color: #FFFFFF; font-weight: 800; padding: 0.3rem 0.8rem; border-radius: var(--radius-full);">
            <span class="dot-pulse-red"></span> <span data-i18n="live_now">लाइव्ह सुरू</span>
          </div>
        </div>

        <div class="tracker-grid">
          <div class="tracker-stat">
            <div class="stat-label" data-i18n="current_location">मंडप स्थान</div>
            <div class="stat-value" id="statCurrentLocation" style="color: #FFFFFF; font-size: 0.95rem; font-weight: 700;">
              <%= yatraStatus.current_location %>
            </div>
          </div>
          <div class="tracker-stat">
            <div class="stat-label" data-i18n="next_halt">पुढील आरती / कार्यक्रम</div>
            <div class="stat-value" style="color: #FFD700; font-size: 0.95rem; font-weight: 700;">
              <%= yatraStatus.next_location %>
            </div>
          </div>
          <div class="tracker-stat">
            <div class="stat-label" data-i18n="distance_covered">महोत्सव प्रगती</div>
            <div class="stat-value" id="statDistanceCovered" style="color: #FFFFFF;">
              Day <%= yatraStatus.current_day %> of <%= yatraStatus.total_days %>
            </div>
          </div>
          <div class="tracker-stat">
            <div class="stat-label" data-i18n="meals_served">आजचे महाप्रसाद</div>
            <div class="stat-value" id="statMealsServed" style="color: #10B981; font-weight: 800;">
              <%= yatraStatus.meals_served_today.toLocaleString('en-IN') %>
            </div>
          </div>
        </div>

        <div style="margin-top: 1.2rem;">
          <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: #CBD5E1; margin-bottom: 0.4rem;">
            <span><span data-i18n="route_progress">१० दिवसांची प्रगती</span> (<span data-i18n="day_label">दिवस</span> <%= yatraStatus.current_day %> of <%= yatraStatus.total_days %>)</span>
            <strong style="color: #FFD700;"><%= Math.round((yatraStatus.current_day / yatraStatus.total_days) * 100) %>%</strong>
          </div>
          <div style="background: rgba(255,255,255,0.1); height: 10px; border-radius: 5px; overflow: hidden; border: 1px solid rgba(255,215,0,0.4);">
            <div style="width: <%= Math.round((yatraStatus.current_day / yatraStatus.total_days) * 100) %>%; height: 100%; background: linear-gradient(90deg, #FF6F00 0%, #FFD700 100%);"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Devotional Counter Metrics Bar -->
<section class="metrics-section" style="background: var(--chintamani-red); color: #FFFFFF; padding: 2.5rem 0;">
  <div class="container">
    <div class="metrics-grid">
      <div class="metric-item">
        <div class="metric-icon" style="color: #FFD700;"><i class="fa-solid fa-users"></i></div>
        <div class="metric-number" style="color: #FFFFFF;">५०,०००+</div>
        <div class="metric-title" style="color: #FFD700;" data-i18n="metric_devotees">दर्शन घेतलेले भाविक</div>
      </div>

      <div class="metric-item">
        <div class="metric-icon" style="color: #FFD700;"><i class="fa-solid fa-bowl-food"></i></div>
        <div class="metric-number" style="color: #FFFFFF;">१,००,०००+</div>
        <div class="metric-title" style="color: #FFD700;" data-i18n="metric_meals">महाप्रसाद व मोदक वाटप</div>
      </div>

      <div class="metric-item">
        <div class="metric-icon" style="color: #FFD700;"><i class="fa-solid fa-crown"></i></div>
        <div class="metric-number" style="color: #FFFFFF;">३८+ Yrs</div>
        <div class="metric-title" style="color: #FFD700;" data-i18n="metric_distance">परंपरेची वर्षे</div>
      </div>

      <div class="metric-item">
        <div class="metric-icon" style="color: #FFD700;"><i class="fa-solid fa-hand-holding-heart"></i></div>
        <div class="metric-number" style="color: #FFFFFF;">३००+</div>
        <div class="metric-title" style="color: #FFD700;" data-i18n="metric_volunteers">सक्रिय कार्यकर्ते व स्वयंसेवक</div>
      </div>
    </div>
  </div>
</section>

<!-- Official Photo Gallery Section -->
<section style="padding: 5rem 0; background: var(--bg-card);">
  <div class="container">
    <div class="section-header" style="text-align: center; max-width: 750px; margin: 0 auto 3rem;">
      <span class="section-tag" style="background: rgba(255,215,0,0.2); color: #B45309; font-weight: 800; padding: 0.3rem 1rem; border-radius: var(--radius-full);">छायाचित्र दालन (PHOTO GALLERY)</span>
      <h2 class="section-title" style="font-size: 2.2rem; margin-top: 0.6rem;">मुंबई सेंट्रलचा राजा - उत्सव क्षणचित्रे</h2>
      <p class="section-subtitle">श्री मूर्ती दर्शन, आगमन सोहळा, आणि सुवर्ण मंडप रोषणाईचे मनमोहक क्षण.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
      <!-- Gallery Card 1: Grand Idol -->
      <div style="background: var(--bg-surface); border-radius: var(--radius-lg); overflow: hidden; border: 2px solid var(--border-light); box-shadow: var(--shadow-md); transition: transform 0.3s ease;">
        <div style="height: 320px; overflow: hidden;">
          <img src="/images/idol.png" alt="Mumbai Central Cha Raja Idol" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;">
        </div>
        <div style="padding: 1.5rem; text-align: center;">
          <span style="background: var(--chintamani-red); color: #FFD700; font-size: 0.75rem; font-weight: 800; padding: 0.2rem 0.8rem; border-radius: var(--radius-full); text-transform: uppercase;">श्री मूर्ती रूप</span>
          <h3 style="font-size: 1.3rem; margin: 0.6rem 0 0.2rem; color: var(--text-main);">मुंबई सेंट्रलचा राजा २०२६ - भव्य दर्शन</h3>
          <p style="font-size: 0.88rem; color: var(--text-muted);">राजेशाही सुवर्ण मुकुट, गडद लाल पैठणी वस्त्र आणि सुगंधी पुष्पहार.</p>
        </div>
      </div>

      <!-- Gallery Card 2: Aagman Sohala -->
      <div style="background: var(--bg-surface); border-radius: var(--radius-lg); overflow: hidden; border: 2px solid var(--border-light); box-shadow: var(--shadow-md); transition: transform 0.3s ease;">
        <div style="height: 320px; overflow: hidden;">
          <img src="/images/aagman.png" alt="Aagman Sohala Procession" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;">
        </div>
        <div style="padding: 1.5rem; text-align: center;">
          <span style="background: #FF6F00; color: #FFFFFF; font-size: 0.75rem; font-weight: 800; padding: 0.2rem 0.8rem; border-radius: var(--radius-full); text-transform: uppercase;">आगमन सोहळा</span>
          <h3 style="font-size: 1.3rem; margin: 0.6rem 0 0.2rem; color: var(--text-main);">ढोल ताशा व भव्य मिरवणूक</h3>
          <p style="font-size: 0.88rem; color: var(--text-muted);">गुलाल उधळण, नाशिक ढोल आणि हजारो भाविकांचा जल्लोष.</p>
        </div>
      </div>

      <!-- Gallery Card 3: Mandap Lighting -->
      <div style="background: var(--bg-surface); border-radius: var(--radius-lg); overflow: hidden; border: 2px solid var(--border-light); box-shadow: var(--shadow-md); transition: transform 0.3s ease;">
        <div style="height: 320px; overflow: hidden;">
          <img src="/images/mandap.png" alt="Mandap Lighting & Aarti" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;">
        </div>
        <div style="padding: 1.5rem; text-align: center;">
          <span style="background: #059669; color: #FFFFFF; font-size: 0.75rem; font-weight: 800; padding: 0.2rem 0.8rem; border-radius: var(--radius-full); text-transform: uppercase;">मंडप शृंगार</span>
          <h3 style="font-size: 1.3rem; margin: 0.6rem 0 0.2rem; color: var(--text-main);">सुवर्ण मंडप रोषणाई व आरती</h3>
          <p style="font-size: 0.88rem; color: var(--text-muted);">बी.आय.टी. चाळ मैदानातील भव्य महामहाल रोषणाई व गर्भगृह.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Key Seva Services & Upakram Grid -->
<section style="padding: 5rem 0; background: var(--bg-surface);">
  <div class="container">
    <div class="section-header" style="text-align: center; max-width: 750px; margin: 0 auto 3rem;">
      <span class="section-tag" style="background: rgba(128,0,32,0.1); color: var(--chintamani-red); font-weight: 800; padding: 0.3rem 1rem; border-radius: var(--radius-full);" data-i18n="services_tag">मंडळ सुविधा आणि मदत</span>
      <h2 class="section-title" style="font-size: 2.2rem; margin-top: 0.6rem;" data-i18n="services_title">भक्तीभावाने भाविकांची सेवा</h2>
      <p class="section-subtitle" data-i18n="services_subtitle">
        बेलासिस रोड बी.आय.टी. चाळ मंडळ २४ तास व्हीआयपी रांग व्यवस्थापन, महाप्रसाद आणि वैद्यकीय मदत पुरवते.
      </p>
    </div>

    <div class="services-grid">
      <div class="service-card">
        <div>
          <div class="service-icon" style="background: rgba(128, 0, 32, 0.1); color: var(--chintamani-red);"><i class="bi bi-card-checklist"></i></div>
          <h3 data-i18n="srv_pass_title">अधिकृत व्हीआयपी पास</h3>
          <p data-i18n="srv_pass_desc">मंडप दर्शन आणि महाआरती रांगेत प्राधान्य मिळवण्यासाठी क्यूआर-कोडयुक्त पास ऑनलाइन मिळवा.</p>
        </div>
        <a href="/register-pass" class="btn btn-chintamani-primary" style="width: 100%;" data-i18n="srv_pass_btn">पास नोंदणी करा &rarr;</a>
      </div>

      <div class="service-card">
        <div>
          <div class="service-icon" style="background: rgba(5, 150, 105, 0.1); color: var(--accent-green);"><i class="bi bi-cup-hot-fill"></i></div>
          <h3 data-i18n="srv_annadan_title">मोदक व महाप्रसाद सेवा</h3>
          <p data-i18n="srv_annadan_desc">दररोज हजारो भाविकांना गरम नाश्ता, चहा, शुद्ध पिण्याचे पाणी आणि मोदक महाप्रसाद वाटप.</p>
        </div>
        <a href="/donate" class="btn btn-chintamani-primary" style="width: 100%; background: linear-gradient(135deg, #059669 0%, #10B981 100%); border-color: #059669;" data-i18n="srv_annadan_btn">महाप्रसादात सहभाग घ्या &rarr;</a>
      </div>

      <div class="service-card">
        <div>
          <div class="service-icon" style="background: rgba(37, 99, 235, 0.1); color: #2563EB;"><i class="bi bi-hospital-fill"></i></div>
          <h3 data-i18n="srv_medical_title">२४/७ वैद्यकीय व सुरक्षा</h3>
          <p data-i18n="srv_medical_desc">डॉक्टरांची टीम, रुग्णवाहिका, व्हिलचेअर मदत आणि २४ तास सीसीटीव्ही व सुरक्षा व्यवस्था.</p>
        </div>
        <a href="/schedule" class="btn btn-chintamani-secondary" style="width: 100%; color: var(--text-main) !important; border-color: var(--border-light);" data-i18n="srv_medical_btn">कार्यक्रम वेळापत्रक पाहा &rarr;</a>
      </div>
    </div>
  </div>
</section>

<!-- Ganeshotsav Event Timeline -->
<section style="padding: 5rem 0; background: var(--bg-card); border-top: 2px solid var(--border-light);">
  <div class="container">
    <div class="section-header" style="text-align: center; max-width: 750px; margin: 0 auto 3rem;">
      <span class="section-tag" style="background: rgba(255,111,0,0.1); color: var(--chintamani-saffron); font-weight: 800; padding: 0.3rem 1rem; border-radius: var(--radius-full);" data-i18n="itinerary_tag">गणेशोत्सव कार्यसूची</span>
      <h2 class="section-title" style="font-size: 2.2rem; margin-top: 0.6rem;" data-i18n="itinerary_title">आगामी आरती आणि गणेशोत्सव कार्यक्रम</h2>
      <p class="section-subtitle" data-i18n="itinerary_subtitle">दैनिक पूजा, महाआरती, भक्ती संध्या आणि विसर्जन मिरवणूक वेळापत्रक पाहा.</p>
    </div>

    <div style="display: grid; gap: 1.5rem; max-width: 900px; margin: 0 auto;">
      <% scheduleData.forEach(item => { %>
        <div style="background: var(--bg-surface); border: 2px solid <%= item.day === yatraStatus.current_day ? 'var(--chintamani-gold)' : 'var(--border-light)' %>; border-radius: var(--radius-md); padding: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          <div>
            <span style="background: <%= item.day === yatraStatus.current_day ? 'var(--chintamani-red)' : '#64748B' %>; color: #FFFFFF; font-size: 0.75rem; font-weight: 800; padding: 0.2rem 0.7rem; border-radius: var(--radius-full); text-transform: uppercase;">
              <% if(item.day === yatraStatus.current_day) { %>
                📍 TODAY'S EVENT (DAY <%= item.day %>)
              <% } else { %>
                DAY <%= item.day %> EVENT
              <% } %>
            </span>
            <h3 style="font-size: 1.25rem; margin: 0.4rem 0 0.2rem; color: var(--text-main);"><%= item.title %></h3>
            <p style="color: var(--text-muted); font-size: 0.9rem;"><i class="bi bi-geo-alt-fill" style="color: var(--chintamani-red);"></i> Ground: <%= item.halt_location %></p>
          </div>

          <div style="text-align: right;">
            <span style="font-size: 0.85rem; font-weight: 700; color: var(--chintamani-saffron);">📞 <%= item.emergency_contact %></span>
          </div>
        </div>
      <% }) %>
    </div>

    <div style="text-align: center; margin-top: 2.5rem;">
      <a href="/schedule" class="btn btn-chintamani-primary" style="padding: 1rem 2.2rem; background: var(--chintamani-red);">
        <i class="bi bi-calendar-check"></i> <span data-i18n="view_full_schedule">संपूर्ण १० दिवसांचे वेळापत्रक पाहा &rarr;</span>
      </a>
    </div>
  </div>
</section>

<!-- Seva Callout Banner -->
<section style="padding: 4.5rem 0; background: linear-gradient(135deg, #160B28 0%, #4A0404 100%); color: #FFFFFF; border-top: 4px solid var(--chintamani-gold);">
  <div class="container" style="text-align: center; max-width: 820px;">
    <div style="font-size: 2.8rem; color: #FFD700; margin-bottom: 0.8rem;"><i class="fa-solid fa-crown"></i></div>
    <h2 style="color: #FFFFFF; font-size: 2.3rem; margin-bottom: 1rem;" data-i18n="callout_title">मुंबई सेंट्रलचा राजा सेवेला पाठिंबा द्या</h2>
    <p style="color: #E2E8F0; font-size: 1.1rem; margin-bottom: 2rem; line-height: 1.7;" data-i18n="callout_desc">
      तुमची देणगी महाप्रसाद, मंडप पुष्प अलंकार आणि समाजोपयोगी उपक्रमांना मदत पुरवते. सर्व देणग्यांना कलम 80G अंतर्गत ५०% कर सवलत मिळतो.
    </p>
    <a href="/donate" class="btn btn-chintamani-primary" style="padding: 1.1rem 2.8rem; font-size: 1.15rem; background: linear-gradient(135deg, #FF6F00 0%, #FFD700 100%); color: #000; font-weight: 800;">
      <i class="bi bi-credit-card-fill"></i> <span data-i18n="donate_now_btn">आत्ताच ऑनलाइन देणगी द्या (८०जी पावतीसह)</span>
    </a>
  </div>
</section>

<%- include('partials/footer') %>
