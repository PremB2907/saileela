<!DOCTYPE html>
<html lang="mr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Mumbai Central Cha Raja Official | मुंबई सेंट्रलचा राजा' %></title>
  
  <!-- Google Web Fonts & Devanagari Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&family=Rozha+One&display=swap" rel="stylesheet">
  
  <!-- FontAwesome & Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <!-- Mumbai Central Cha Raja Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Top Announcement Bar & Language Switcher -->
  <div class="topbar-chintamani">
    <div class="container topbar-flex">
      <div class="topbar-info">
        <span data-i18n="est_label"><b>स्थापना : १९८८</b></span>
        <span data-i18n="reg_label"><b>नोंदणी क्र. : ई-३८९२ मुंबई</b></span>
        <a href="https://www.instagram.com/mumbaicentralcharajaofficial" target="_blank" rel="noopener noreferrer" style="color: #FFD700; font-weight: 700; margin-left: 0.5rem; display: inline-flex; align-items: center; gap: 0.3rem;">
          <i class="fa-brands fa-instagram" style="font-size: 1.1rem;"></i> @mumbaicentralcharajaofficial
        </a>
      </div>

      <div style="display: flex; align-items: center; gap: 1.2rem;">
        <!-- Announcement Marquee -->
        <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.82rem;">
          <span class="live-pulse-tag" style="background: #FFD700; color: #000; padding: 0.15rem 0.6rem;" data-i18n="live_yatra_badge">LIVE DARSHAN</span>
          <span data-i18n="announcement_text">🌺 मुंबई सेंट्रलचा राजा गणेशोत्सव २०२६: बी.आय.टी. चाळ मैदान, मुंबई सेंट्रल येथे दर्शन व आरती सुरू.</span>
        </div>

        <!-- Language Switcher Pills -->
        <div class="lang-switcher-container">
          <button class="lang-btn active" data-lang="mr">🚩 मराठी</button>
          <button class="lang-btn" data-lang="hi">🇮🇳 हिंदी</button>
          <button class="lang-btn" data-lang="en">🇬🇧 EN</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Site Header -->
  <header class="site-header">
    <div class="container header-inner">
      <!-- Brand Logo -->
      <a href="/" class="brand-logo">
        <div class="brand-icon-mandal" style="background: linear-gradient(135deg, #800020 0%, #FFD700 100%); color: #FFFFFF;">
          <i class="fa-solid fa-crown"></i>
        </div>
        <div class="brand-text">
          <h1>मुंबई सेंट्रलचा राजा</h1>
          <p>बेलासिस रोड बी.आय.टी. चाळ सार्वजनिक श्री गणेशोत्सव मंडळ (Reg. E-3892)</p>
        </div>
      </a>

      <!-- Navigation Links -->
      <nav class="main-nav" id="mainNav">
        <ul>
          <li><a href="/" class="nav-link <%= activeTab === 'home' ? 'active' : '' %>" data-i18n="nav_home"><i class="bi bi-house-door-fill"></i> मुखपृष्ठ</a></li>
          <li><a href="/schedule" class="nav-link <%= activeTab === 'schedule' ? 'active' : '' %>" data-i18n="nav_schedule"><i class="bi bi-calendar-event-fill"></i> गणेशोत्सव वेळापत्रक</a></li>
          <li><a href="/register-pass" class="nav-link <%= activeTab === 'register' ? 'active' : '' %>" data-i18n="nav_pass"><i class="bi bi-person-badge-fill"></i> व्हीआयपी पास</a></li>
          <li><a href="/pass-status" class="nav-link <%= activeTab === 'pass-status' ? 'active' : '' %>" data-i18n="nav_verify"><i class="bi bi-qr-code-scan"></i> पास पडताळणी</a></li>
          <li><a href="/donate" class="nav-link <%= activeTab === 'donate' ? 'active' : '' %>" data-i18n="nav_donate"><i class="bi bi-heart-fill" style="color: #FFD700;"></i> देणगी</a></li>
          <li><a href="/admin" class="nav-link <%= activeTab === 'admin' ? 'active' : '' %>" data-i18n="nav_admin"><i class="bi bi-speedometer2"></i> प्रशासन</a></li>
          
          <!-- Live Darshan Button -->
          <li>
            <button type="button" id="btnLiveDarshanModal" class="btn-live-glowing" data-i18n="live_darshan_btn">
              <i class="fa-solid fa-circle-play"></i> लाइव्ह दर्शन
            </button>
          </li>

          <!-- Theme Toggle -->
          <li>
            <button id="themeToggle" class="theme-toggle-btn" title="Toggle Theme" aria-label="Toggle Dark/Light Mode">
              <i class="bi bi-moon-stars-fill"></i>
            </button>
          </li>
        </ul>
      </nav>

      <!-- Mobile Navigation Toggle -->
      <button class="mobile-toggle" id="mobileToggle" aria-label="Toggle navigation menu">
        <i class="bi bi-list"></i>
      </button>
    </div>
  </header>

  <!-- Live Video Popup Modal -->
  <div id="videoModal" class="chintamani-modal">
    <div class="chintamani-modal-content">
      <div class="chintamani-modal-header">
        <div>
          <span style="color: #FFD700; font-weight: 800; font-size: 0.8rem; text-transform: uppercase;">Mumbai Central Cha Raja Official</span>
          <h3 style="color: #FFFFFF; font-size: 1.25rem; margin-top: 0.1rem;">🔴 Live Ganeshotsav Aarti & Darshan Stream</h3>
        </div>
        <button type="button" id="btnCloseVideoModal" style="background: none; border: none; color: #FFFFFF; font-size: 1.8rem; cursor: pointer;">&times;</button>
      </div>
      <div style="padding: 1rem; background: #000000; text-align: center;">
        <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px;">
          <iframe id="videoFrame" src="https://www.youtube.com/embed/live_stream?channel=UCmumbaicentralcharaja" style="position: absolute; top:0; left:0; width:100%; height:100%; border:none;" allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </div>
