<!DOCTYPE html>
<html lang="mr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Mumbai Central Cha Raja | Belasis Road B.I.T. Chawl Sarvajanik Shri Ganeshotsav Mandal' %></title>
  <meta name="description" content="Official Portal of Mumbai Central Cha Raja - Belasis Road B.I.T. Chawl Sarvajanik Shri Ganeshotsav Mandal. Immersive digital temple experience, live darshan, history, committee & donation.">
  
  <!-- Google Web Fonts & Devanagari Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Noto+Serif+Devanagari:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,400&family=Rozha+One&display=swap" rel="stylesheet">
  
  <!-- FontAwesome & Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <!-- Swiper.js & GSAP -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  <!-- Mumbai Central Cha Raja Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/png" href="/images/logo.png">
</head>
<body>

  <!-- Mandal Top Header Banner -->
  <div class="topbar-chintamani">
    <div class="container">
      <div class="mandal-top-banner-flex">
        <!-- Top Meta (Est & Reg) -->
        <div class="mandal-top-meta">
          <span data-i18n="est_label">स्थापना : १९८८</span>
          
          <div style="display: flex; align-items: center; gap: 1.2rem;">
            <a href="https://www.instagram.com/mumbaicentralcharajaofficial" target="_blank" rel="noopener noreferrer" style="color: var(--bg-ivory); font-weight: 700; text-decoration: none; font-size: 0.88rem;">
              <i class="fa-brands fa-instagram" style="color: var(--royal-gold);"></i> @mumbaicentralcharajaofficial
            </a>
            <!-- Language Switcher Pills -->
            <div class="lang-switcher-container">
              <button class="lang-btn active" data-lang="mr">मराठी</button>
              <button class="lang-btn" data-lang="en">English</button>
            </div>
          </div>

          <span data-i18n="reg_label">नोंदणी क्र. : ई-३८९२ मुंबई</span>
        </div>

        <!-- Mandal Devanagari Heading -->
        <h1 class="mandal-banner-3d-text" data-i18n="mandal_full_title">
          बेलासिस रोड बी.आय.टी. चाळ सार्वजनिक श्री गणेशोत्सव मंडळ, मुंबई
        </h1>
      </div>
    </div>
  </div>

  <!-- Main Site Sticky Header -->
  <header class="site-header">
    <div class="container header-inner">
      <!-- Official Mandal Logo Crest -->
      <a href="/" class="brand-logo">
        <div style="width: 54px; height: 54px; display: flex; align-items: center; justify-content: center;">
          <img src="/images/logo.png" alt="Mumbai Central Cha Raja Logo" style="width: 100%; height: 100%; object-fit: contain;">
        </div>
        <div class="brand-text">
          <h2 data-i18n="mandal_name_header">मुंबई सेंट्रलचा राजा</h2>
          <p data-i18n="mandal_sub_header">सार्वजनिक श्री गणेशोत्सव मंडळ</p>
        </div>
      </a>

      <!-- Navigation Links -->
      <nav class="main-nav" id="mainNav">
        <ul>
          <li>
            <button class="btn btn-outline" style="padding: 0.25rem 0.75rem; font-size: 0.78rem; font-weight: 800; color: var(--temple-maroon); border-color: var(--temple-maroon);" id="btnLiveDarshanModal">
              <i class="fa-solid fa-tower-broadcast" style="color: var(--primary-saffron);"></i> LIVE DARSHAN
            </button>
          </li>
          <li><a href="/" class="nav-link <%= activeTab === 'home' ? 'active' : '' %>" data-i18n="nav_home">मुखपृष्ठ</a></li>
          <li><a href="/about" class="nav-link <%= activeTab === 'about' ? 'active' : '' %>" data-i18n="nav_about">आमच्याबद्दल</a></li>
          <li><a href="/schedule" class="nav-link <%= activeTab === 'schedule' ? 'active' : '' %>" data-i18n="nav_schedule">गणेशोत्सव</a></li>
          <li><a href="/glimpses" class="nav-link <%= activeTab === 'glimpses' ? 'active' : '' %>" data-i18n="nav_glimpses">वर्षभरातील क्षणचित्रे</a></li>
          <li><a href="/photo-booth" class="nav-link <%= activeTab === 'photobooth' ? 'active' : '' %>" data-i18n="nav_photobooth">फोटो बूथ</a></li>
          <li><a href="/social-work" class="nav-link <%= activeTab === 'socialwork' ? 'active' : '' %>" data-i18n="nav_socialwork">सामाजिक कार्य</a></li>
          <li><a href="/tshirt" class="nav-link <%= activeTab === 'tshirt' ? 'active' : '' %>" data-i18n="nav_tshirt">टी-शर्ट बुकिंग</a></li>
          <li><a href="/committee" class="nav-link <%= activeTab === 'committee' ? 'active' : '' %>" data-i18n="nav_committee">कार्यकारिणी</a></li>
          <li><a href="/contact" class="nav-link <%= activeTab === 'contact' ? 'active' : '' %>" data-i18n="nav_contact">संपर्क</a></li>
          
          <!-- Distinct Donate Button -->
          <li>
            <a href="/donate" class="btn btn-primary" style="padding: 0.45rem 1.2rem; font-size: 0.85rem;" data-i18n="nav_donate">
              देणगी
            </a>
          </li>
        </ul>
      </nav>

      <!-- Mobile Navigation Toggle -->
      <button class="mobile-toggle" id="mobileToggle" aria-label="Toggle menu">
        <i class="bi bi-list"></i>
      </button>
    </div>
  </header>

  <!-- Live Video Popup Modal -->
  <div id="videoModal" class="chintamani-modal">
    <div class="chintamani-modal-content">
      <div class="chintamani-modal-header">
        <div style="display: flex; align-items: center; gap: 0.8rem;">
          <img src="/images/logo.png" alt="Logo" style="width: 36px; height: 36px;">
          <div>
            <span style="color: var(--gold-soft); font-weight: 800; font-size: 0.8rem; text-transform: uppercase;">Mumbai Central Cha Raja</span>
            <h3 style="color: #FFFFFF; font-size: 1.1rem; margin: 0;">Live Ganeshotsav Aarti & Mandap Stream</h3>
          </div>
        </div>
        <button type="button" id="btnCloseVideoModal" style="background: none; border: none; color: #FFFFFF; font-size: 1.8rem; cursor: pointer;">&times;</button>
      </div>
      <div style="padding: 1rem; background: #000000; text-align: center;">
        <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px;">
          <iframe id="videoFrame" src="https://www.youtube.com/embed/live_stream?channel=UCmumbaicentralcharaja" style="position: absolute; top:0; left:0; width:100%; height:100%; border:none;" allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </div>
