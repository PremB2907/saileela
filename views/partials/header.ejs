<!DOCTYPE html>
<html lang="mr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Mumbai Central Cha Raja Official | मुंबई सेंट्रलचा राजा' %></title>
  
  <!-- Google Web Fonts & Devanagari Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&family=Rozha+One&display=swap" rel="stylesheet">
  
  <!-- FontAwesome & Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <!-- Skiper UI & Swiper.js Modern Animation Library -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/motion@10.16.2/dist/motion.js"></script>

  <!-- Mumbai Central Cha Raja Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Chinchpokli Style Top Saffron Header Banner -->
  <div class="topbar-chintamani">
    <div class="container">
      <div class="mandal-top-banner-flex">
        <!-- Top Meta (Est & Reg) -->
        <div class="mandal-top-meta">
          <span data-i18n="est_label">स्थापना : १९८८</span>
          
          <div style="display: flex; align-items: center; gap: 1rem;">
            <a href="https://www.instagram.com/mumbaicentralcharajaofficial" target="_blank" rel="noopener noreferrer" style="color: #FFFFFF; font-weight: 700; text-decoration: none;">
              <i class="fa-brands fa-instagram" style="color: #FFD700;"></i> @mumbaicentralcharajaofficial
            </a>
            <!-- Language Switcher Pills -->
            <div class="lang-switcher-container">
              <button class="lang-btn active" data-lang="mr">🚩 मराठी</button>
              <button class="lang-btn" data-lang="hi">🇮🇳 हिंदी</button>
              <button class="lang-btn" data-lang="en">🇬🇧 EN</button>
            </div>
          </div>

          <span data-i18n="reg_label">नोंदणी क्र. : ई-३८९२ मुंबई</span>
        </div>

        <!-- Giant 3D Devanagari Mandal Heading -->
        <h1 class="mandal-banner-3d-text">
          बेलासिस रोड बी.आय.टी. चाळ सार्वजनिक श्री गणेशोत्सव मंडळ, मुंबई
        </h1>
      </div>
    </div>
  </div>

  <!-- Main Site Header -->
  <header class="site-header">
    <div class="container header-inner">
      <!-- Crest Logo Badge -->
      <a href="/" class="brand-logo">
        <div class="brand-icon-mandal" style="background: linear-gradient(135deg, #800020 0%, #FF6F00 100%); color: #FFD700; width: 62px; height: 62px; font-size: 2rem;">
          <i class="fa-solid fa-crown"></i>
        </div>
        <div class="brand-text">
          <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--chintamani-red); margin: 0;">मुंबई सेंट्रलचा राजा</h2>
          <p style="font-size: 0.75rem; color: var(--chintamani-saffron); font-weight: 700; margin: 0;">सार्वजनिक श्री गणेशोत्सव मंडळ</p>
        </div>
      </a>

      <!-- Navigation Links -->
      <nav class="main-nav" id="mainNav">
        <ul>
          <li>
            <span class="live-pulse-tag" style="background: #7C3AED; color: #FFFFFF; font-size: 0.72rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: var(--radius-full); cursor: pointer;" id="btnLiveDarshanModal">
              LIVE
            </span>
          </li>
          <li><a href="/" class="nav-link <%= activeTab === 'home' ? 'active' : '' %>" data-i18n="nav_home">मुखपृष्ठ</a></li>
          <li><a href="/schedule" class="nav-link <%= activeTab === 'schedule' ? 'active' : '' %>" data-i18n="nav_schedule">गणेशोत्सव</a></li>
          <li><a href="/tshirt" class="nav-link <%= activeTab === 'tshirt' ? 'active' : '' %>" data-i18n="nav_tshirt" style="color: #800020; font-weight: 800;">टी-शर्ट बुकिंग 👕</a></li>
          <li><a href="/register-pass" class="nav-link <%= activeTab === 'register' ? 'active' : '' %>" data-i18n="nav_pass">व्हीआयपी पास</a></li>
          <li><a href="/pass-status" class="nav-link <%= activeTab === 'pass-status' ? 'active' : '' %>" data-i18n="nav_verify">पास पडताळणी</a></li>
          <li><a href="/contact" class="nav-link <%= activeTab === 'contact' ? 'active' : '' %>" data-i18n="nav_contact">संपर्क</a></li>
          
          <!-- Distinct Red Donate Button -->
          <li>
            <a href="/donate" class="btn btn-chintamani-primary" style="background: #DC2626; color: #FFFFFF; font-weight: 800; padding: 0.5rem 1.4rem; border-radius: var(--radius-sm); border: none;" data-i18n="nav_donate">
              देणगी
            </a>
          </li>

          <!-- Theme Toggle -->
          <li>
            <button id="themeToggle" class="theme-toggle-btn" title="Toggle Theme" aria-label="Toggle Dark/Light Mode">
              <i class="bi bi-moon-stars-fill"></i>
            </button>
          </li>
        </ul>
      </nav>

      <!-- Mobile Navigation Toggle -->
      <button class="mobile-toggle" id="mobileToggle" aria-label="Toggle navigation menu">
        <i class="bi bi-list"></i>
      </button>
    </div>
  </header>

  <!-- Live Video Popup Modal -->
  <div id="videoModal" class="chintamani-modal">
    <div class="chintamani-modal-content">
      <div class="chintamani-modal-header">
        <div>
          <span style="color: #FFD700; font-weight: 800; font-size: 0.8rem; text-transform: uppercase;">Mumbai Central Cha Raja Official</span>
          <h3 style="color: #FFFFFF; font-size: 1.25rem; margin-top: 0.1rem;">🔴 Live Ganeshotsav Aarti & Darshan Stream</h3>
        </div>
        <button type="button" id="btnCloseVideoModal" style="background: none; border: none; color: #FFFFFF; font-size: 1.8rem; cursor: pointer;">&times;</button>
      </div>
      <div style="padding: 1rem; background: #000000; text-align: center;">
        <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px;">
          <iframe id="videoFrame" src="https://www.youtube.com/embed/live_stream?channel=UCmumbaicentralcharaja" style="position: absolute; top:0; left:0; width:100%; height:100%; border:none;" allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </div>
