<%- include('partials/header') %>

<section style="padding: 4rem 0; background: var(--bg-surface);">
  <div class="container">
    <div class="section-header" style="text-align: center; max-width: 750px; margin: 0 auto 3rem;">
      <span class="section-tag" style="background: rgba(128,0,32,0.1); color: var(--chintamani-red); font-weight: 800; padding: 0.3rem 1rem; border-radius: var(--radius-full);" data-i18n="pass_title">अधिकृत व्हीआयपी पास नोंदणी</span>
      <h2 class="section-title" style="font-size: 2.2rem; margin-top: 0.6rem;">मुंबई सेंट्रलचा राजा दर्शन पास २०२६</h2>
      <p class="section-subtitle" data-i18n="pass_subtitle">
        मुंबई सेंट्रलचा राजा दर्शन व आरतीसाठी तुमचा त्वरित क्यूआर कोड पास मिळवण्यासाठी खालील माहिती भरा.
      </p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background: #FEE2E2; border: 1px solid #FCA5A5; color: #991B1B; padding: 1rem; border-radius: 8px; max-width: 800px; margin: 0 auto 2rem; text-align: center;">
        <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
      </div>
    <% } %>

    <div class="form-card" style="max-width: 780px; margin: 0 auto; background: var(--bg-card); padding: 2.5rem; border-radius: var(--radius-lg); border: 2px solid var(--border-light); box-shadow: var(--shadow-md);">
      <form id="passForm" action="/register-pass" method="POST">
        <!-- Step 1: Devotee Details -->
        <div id="step1">
          <div class="form-group" style="margin-bottom: 1.2rem;">
            <label class="form-label" for="full_name" style="font-weight: 700;" data-i18n="pass_fullname">भाविकाचे पूर्ण नाव *</label>
            <input type="text" id="full_name" name="full_name" class="form-control" placeholder="उदा. राहुल शर्मा" required value="<%= typeof formData !== 'undefined' ? formData.full_name : '' %>">
          </div>

          <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.2rem;">
            <div class="form-group">
              <label class="form-label" for="phone" style="font-weight: 700;" data-i18n="pass_phone">मोबाईल नंबर (SMS पाससाठी) *</label>
              <input type="tel" id="phone" name="phone" class="form-control" placeholder="१० अंकी मोबाईल नंबर" required value="<%= typeof formData !== 'undefined' ? formData.phone : '' %>">
            </div>

            <div class="form-group">
              <label class="form-label" for="email" style="font-weight: 700;" data-i18n="donor_email">ईमेल पत्ता (पर्यायी)</label>
              <input type="email" id="email" name="email" class="form-control" placeholder="rahul@example.com" value="<%= typeof formData !== 'undefined' ? formData.email : '' %>">
            </div>
          </div>

          <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.2rem;">
            <div class="form-group">
              <label class="form-label" for="age" style="font-weight: 700;" data-i18n="pass_age">वय *</label>
              <input type="number" id="age" name="age" class="form-control" min="5" max="100" placeholder="उदा. ३४" required value="<%= typeof formData !== 'undefined' ? formData.age : '' %>">
            </div>

            <div class="form-group">
              <label class="form-label" for="gender" style="font-weight: 700;" data-i18n="pass_gender">लिंग *</label>
              <select id="gender" name="gender" class="form-select" required>
                <option value="">लिंग निवडा</option>
                <option value="Male" <%= typeof formData !== 'undefined' && formData.gender === 'Male' ? 'selected' : '' %>>पुरुष (Male)</option>
                <option value="Female" <%= typeof formData !== 'undefined' && formData.gender === 'Female' ? 'selected' : '' %>>स्त्री (Female)</option>
                <option value="Other" <%= typeof formData !== 'undefined' && formData.gender === 'Other' ? 'selected' : '' %>>इतर (Other)</option>
              </select>
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 1.5rem;">
            <label class="form-label" for="city" style="font-weight: 700;" data-i18n="pass_city">शहर / परिसर *</label>
            <input type="text" id="city" name="city" class="form-control" placeholder="उदा. मुंबई सेंट्रल / भायखळा / दादर" required value="<%= typeof formData !== 'undefined' ? formData.city : '' %>">
          </div>

          <div style="text-align: right; margin-top: 2rem;">
            <button type="button" id="btnStepNext" class="btn btn-chintamani-primary" style="background: var(--chintamani-red);">
              पुढे जा &rarr;
            </button>
          </div>
        </div>

        <!-- Step 2: Access Category & ID Proof -->
        <div id="step2" style="display: none;">
          <div class="form-group" style="margin-bottom: 1.2rem;">
            <label class="form-label" for="batch" style="font-weight: 700;">पास प्रकार / प्रवेश श्रेणी *</label>
            <select id="batch" name="batch" class="form-select" required>
              <option value="VIP Mandap Entry & Aarti Pass">व्हीआयपी दर्शन व आरती पास (VIP Queue Access)</option>
              <option value="Karyakarta / Sevak Pass">कार्यकर्ते व सेवक पास (Mandal Volunteer)</option>
              <option value="Senior Citizen & Special Darshan">ज्येष्ठ नागरिक व दिव्यांग भाविक पास</option>
              <option value="General Devotee Priority Pass">सर्वसाधारण भाविक प्राधान्य पास</option>
            </select>
          </div>

          <div class="form-group" style="margin-bottom: 1.2rem;">
            <label class="form-label" for="emergency_contact" style="font-weight: 700;">आपत्कालीन संपर्क नंबर *</label>
            <input type="tel" id="emergency_contact" name="emergency_contact" class="form-control" placeholder="१० अंकी संपर्क क्रमांक" required value="<%= typeof formData !== 'undefined' ? formData.emergency_contact : '' %>">
          </div>

          <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
            <div class="form-group">
              <label class="form-label" for="id_proof_type" style="font-weight: 700;" data-i18n="pass_idtype">सरकारी ओळखपत्र प्रकार *</label>
              <select id="id_proof_type" name="id_proof_type" class="form-select" required>
                <option value="Aadhaar Card">आधार कार्ड (Aadhaar)</option>
                <option value="PAN Card">पॅन कार्ड (PAN)</option>
                <option value="Voter ID">मतदान कार्ड (Voter ID)</option>
                <option value="Driving License">ड्रायव्हिंग लायसन्स</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="id_proof_number" style="font-weight: 700;" data-i18n="pass_idnum">ओळखपत्र क्रमांक *</label>
              <input type="text" id="id_proof_number" name="id_proof_number" class="form-control" placeholder="उदा. XXXX-XXXX-4812" required value="<%= typeof formData !== 'undefined' ? formData.id_proof_number : '' %>">
            </div>
          </div>

          <div style="display: flex; justify-content: space-between; margin-top: 2rem;">
            <button type="button" id="btnStepPrev" class="btn btn-chintamani-secondary" style="color: var(--text-main) !important; border-color: var(--border-light);">
              &larr; मागे जा
            </button>
            <button type="submit" class="btn btn-chintamani-primary" style="background: var(--chintamani-red);">
              <i class="bi bi-check-circle-fill"></i> <span data-i18n="pass_submit_btn">अधिकृत पास मिळवा</span>
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<script src="/js/pass-form.js"></script>
<%- include('partials/footer') %>
